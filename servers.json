{
  "mcpServers": {
    "gravity": {
      "enabled": true,
      "timeout": 30,
      "command": "node",
      "args": [
        "/gravity-mcp/src/index.js"
      ],
      "transportType": "stdio"
    },
    "ga4": {
      "enabled": true,
      "timeout": 30,
      "command": "python",
      "args": ["-m", "analytics_mcp.server"],
      "transportType": "stdio"
    }
  }
}
