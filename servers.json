cat > servers.json << 'EOF'
{
  "mcpServers": {
    "gravity": {
      "enabled": true,
      "timeout": 30,
      "command": "node",
      "args": [
        "/gravity-mcp/src/index.js"
      ],
      "transportType": "stdio",
      "env": {
        "GRAVITY_FORMS_CONSUMER_KEY": "${GRAVITY_FORMS_CONSUMER_KEY}",
        "GRAVITY_FORMS_CONSUMER_SECRET": "${GRAVITY_FORMS_CONSUMER_SECRET}",
        "GRAVITY_FORMS_BASE_URL": "${GRAVITY_FORMS_BASE_URL}"
      }
    }
  }
}
EOF
